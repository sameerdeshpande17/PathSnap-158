# PathSnap Backend Configuration
# Copy to .env and adjust as needed. Do not commit .env.

# Server bind address
PATHSNAP_HOST=0.0.0.0

# Server port
PATHSNAP_PORT=8000

# Comma-separated list of allowed CORS origins.
# Default: empty (no cross-origin access).
# Example for local development:
# PATHSNAP_CORS_ORIGINS=http://localhost:5173,http://192.168.1.101:5173
PATHSNAP_CORS_ORIGINS=
